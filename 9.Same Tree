class Solution:
    def isSameTree(self, p: TreeNode | None, q: TreeNode | None) -> bool:
        result = []
        def dfs(node):
            if node is None:
                result.append("null")
                return
            result.append(node.val)
            dfs(node.left)
            dfs(node.right)
        dfs(p)
        result_1 = result
        result = []
        dfs(q)
        return result_1 == result
