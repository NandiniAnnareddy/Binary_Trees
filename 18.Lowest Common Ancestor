# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, x):
#         self.val = x
#         self.left = None
#         self.right = None

class Solution:
    def lowestCommonAncestor(self, root: 'TreeNode', p: 'TreeNode', q: 'TreeNode') -> 'TreeNode':
        def dfs(node,p,q):
            if node is None:
                return None
            if node == p or node == q:
                return node
            left = dfs(node.left,p,q)
            right = dfs(node.right,p,q)
            if left == right == None:
                return None
            elif left != None and right == None:
                return left
            elif left == None and right != None:
                return right
            else:
                return node
        return dfs(root,p,q)
