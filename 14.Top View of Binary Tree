'''
class Node:
    def __init__(self, val):
        self.data = val
        self.left = None
        self.right = None
'''

class Solution:
    def topView(self, root):
        queue = []
        nodes = []
        queue.append([root,0,0])
        while queue:
            popped = queue.pop(0)
            node = popped[0]
            vertical = popped[1]
            level = popped[2]
            nodes.append(popped)
            if node.left:
                queue.append([node.left,vertical-1,level+1])
            if node.right:
                queue.append([node.right,vertical+1,level+1])
        nodes.sort(key=lambda x: (x[1], x[2]))
        mapp = {}
        for node in nodes:
            if node[1] in mapp:
                mapp[node[1]].append(node[0].data)
            else:
                mapp[node[1]] = [node[0].data]
        result = []
        for key,values in mapp.items():
            result.append(values[0])
        return result
        
        
